# Copy to repo-root .env and fill in (never commit .env)
ELEVENLABS_API_KEY=

# xAI Grok Imagine (Swaps tab: generate / edit art into catalog slots)
# https://console.x.ai/ — create a key with Imagine access
XAI_API_KEY=

# Optional: game checkout for Studio "Export → Game" (no machine-specific defaults)
# SAKURA_GAME_ROOT=/path/to/CourtReinland/nightmaregolf
# NIGHTMARE_GOLF_ROOT=/path/to/CourtReinland/nightmaregolf

# Optional: Unity project root for `sakura import` (overrides title.repo_path)
# SAKURA_UNITY_ROOT=/path/to/UnityProject

# Optional: where generated VO is also written for the live game
# SAKURA_GAME_AUDIO_ROOT=/path/to/CourtReinland/sakura-match
# or point at public/:
# SAKURA_GAME_PUBLIC=/path/to/sakura-match/public
